# =================================================================
# LiteLLM & LLM Provider Configuration
# =================================================================
# If using Gemini directly via LiteLLM:
GEMINI_API_KEY=your_gemini_api_key_here

# If using a LiteLLM proxy/gateway:
# LITELLM_API_KEY=your_proxy_key_here
# LITELLM_BASE_URL=https://your-proxy-endpoint.com/

# =================================================================
# Embedding & Model Configuration
# =================================================================
# Hugging Face token (required for downloading restricted models or higher rate limits)
HF_TOKEN=your_huggingface_token_here

# =================================================================
# Vector DB Configuration
# =================================================================
# Path for persistent ChromaDB storage
CHROMA_PERSIST_DIR=./db/chroma
